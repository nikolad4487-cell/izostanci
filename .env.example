# Samo lokalni PostgreSQL iz compose.yml. Ne koristite ove lokalne podatke na Vercelu.
DATABASE_URL="postgresql://dolaznost:dolaznost_local@127.0.0.1:54329/dolaznost"
# Vercel: DATABASE_URL = Supabase Connect → Transaction pooler (6543) ili Session pooler (5432).
# DIRECT_URL = opcionalni Session pooler (5432) ili Direct connection za migracije.
# Lozinku baze u URL-u treba URL-enkodirati. Zadržite TLS provjeru za Supabase.
# APP_PASSWORD = vlastita lozinka aplikacije od najmanje 16 znakova; ne DB lozinka.
